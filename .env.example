# Synthetic Humans Environment Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database
# Production/Docker: postgresql+asyncpg://synthetic:synthetic@postgres:5432/synthetic_humans
# Local development fallback: sqlite+aiosqlite:///./synthetic_humans.db
DATABASE_URL=sqlite+aiosqlite:///./synthetic_humans.db
POSTGRES_DB=synthetic_humans
POSTGRES_USER=synthetic
POSTGRES_PASSWORD=synthetic

# Redis (Job Queue & State Cache)
# Docker: redis://redis:6379/0
# Local: redis://localhost:6379/0 (in-memory async queue fallback active if redis offline)
REDIS_URL=redis://localhost:6379/0

# LLM Provider Configuration (mock, openai, gemini)
DEFAULT_LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Simulation & Browser Execution
MAX_CONCURRENT_BROWSERS=5
DEFAULT_MAX_STEPS=30
DEFAULT_MAX_DURATION_SECONDS=180
HEADLESS_BROWSER=true
RECORD_SCREENSHOTS=true
STORAGE_DIR=./data/screenshots

# Frontend
VITE_API_URL=http://localhost:8000
